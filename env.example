# ==============================================================================
# CCTV Monitoring Backend — Environment Variables
# ==============================================================================
# Copy this file to .env for local development:
#   cp env.example .env
#
# For production (AWS ECS), store all secrets in AWS Systems Manager
# Parameter Store using: ./aws/ssm-params.sh
#
# ⚠️  NEVER commit a .env file with real credentials to git.
# ==============================================================================

# ── Server ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080

# ── Public URL ─────────────────────────────────────────────────────────────────
# Set to your ALB / CloudFront / custom domain URL in production.
# E.g. https://api.yourdomain.com  or  https://abc123.ap-south-1.elb.amazonaws.com
PUBLIC_BASE_URL=https://api.yourdomain.com

# ── MongoDB ────────────────────────────────────────────────────────────────────
# Use MongoDB Atlas (recommended for production). Whitelist your ECS outbound IPs
# or use VPC peering for private connectivity.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/cctv_monitoring

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 48
ACCESS_TOKEN_SECRET=your_super_secret_access_token_key_min_32_chars
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key_min_32_chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d

# ── OTP ────────────────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10

# ── Email (SMTP) ───────────────────────────────────────────────────────────────
# Recommended: AWS SES (cheap, reliable) or SendGrid / Mailgun for transactional email
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM=CCTV Monitor <noreply@yourdomain.com>

# ── Cloudinary ─────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Firebase (FCM) ─────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your_project.iam.gserviceaccount.com
# Paste the entire PEM block (replace literal \n with actual newlines in shell)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── MediaMTX ───────────────────────────────────────────────────────────────────
# In ECS, the mediamtx sidecar runs in the same network namespace (awsvpc),
# so loopback addresses work.
MEDIAMTX_URL=http://127.0.0.1:8889
MEDIAMTX_API_URL=http://127.0.0.1:9997/v3
# Generate with: openssl rand -hex 32
MEDIAMTX_STREAM_SECRET=your_mediamtx_stream_secret_min_32_chars
STREAM_TOKEN_EXPIRY=24h

# ── Synthetic Demo Feeds (ffmpeg) ──────────────────────────────────────────────
# Set to false in production (saves CPU). Only enable for live demos.
ENABLE_DEMO_FEEDS=false

# ── Razorpay ───────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_live_secret

# ── Rate Limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list. Production must only contain HTTPS origins.
CORS_ORIGIN=https://yourdomain.com,https://app.yourdomain.com

# ── Internal System API Key ────────────────────────────────────────────────────
# Used by camera hardware and internal webhooks to bypass rate limiting.
# REQUIRED in all environments — no hardcoded default.
# Generate: openssl rand -hex 32
# On AWS: set via SSM Parameter Store (/cctv/prod/SYSTEM_API_KEY)
SYSTEM_API_KEY=your_internal_system_api_key_min_32_chars

# ─── Deployment / Public URL ────────────────────────────────────────────────
# Set this to the HTTPS URL where the API is publicly reachable.
# On AWS ECS: set via SSM Parameter Store (/cctv/prod/PUBLIC_BASE_URL)
# Locally: leave unset — falls back to Request host headers, then localhost.
# PUBLIC_BASE_URL=https://api.yourdomain.com

# Demo feeds (synthetic RTSP streams via ffmpeg)
# Set to "false" in production to eliminate unnecessary CPU usage.
ENABLE_DEMO_FEEDS=false
